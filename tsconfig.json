{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": [
    "src",
    "api",
    "e2e",
    "scripts",
    "supabase/functions",
    "supabase/tests",
    "vite.config.ts",
    "playwright.config.ts",
    "vitest.setup.ts",
    "eslint.config.js"
  ],
  // The Edge Function entry points run on Deno: `jsr:` specifiers and the Deno
  // global are not part of this project's TypeScript program. Everything they
  // import that matters — the rules themselves — lives beside them and is
  // checked.
  "exclude": ["supabase/functions/*/index.ts"]
}
