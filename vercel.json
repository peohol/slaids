{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/agent/v1.ts": {
      "excludeFiles": "node_modules/@sparticuz/chromium/bin/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/agent/v1/:__slaidsPath*",
      "destination": "/api/agent/v1"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/agent/v1/mcp",
      "destination": "/api/agent/v1?__slaidsPath=/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/agent/v1?__slaidsPath=/.well-known/oauth-protected-resource"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/s/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/s",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
