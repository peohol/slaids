  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run build:app",
    "build:app": "vite build && npm run build:agent-api",
    "build:agent-api": "vite build --config vite.agent-api.config.ts && node scripts/check-agent-bundle.mjs",
